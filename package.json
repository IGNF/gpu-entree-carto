{
  "name": "entree-carto",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "description": "Entrée cartographique GPU (Vue 3, VueDSFR, OpenLayers)",
  "main": "./dist/entree-carto.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:demo && npm run build:lib && npm run build:geometry-editor && npm run build:sketch",
    "build:demo": "vue-tsc --noEmit && vite build",
    "build:demo:pages": "ENTREE_CARTO_DEMO_PAGES=1 GITHUB_REPOSITORY=ignf/gpu-entree-carto npm run build:demo",
    "build:lib": "vue-tsc --noEmit && LIB_MINIFY=0 vite build --config vite.lib.config.ts && LIB_MINIFY=1 vite build --config vite.lib.config.ts",
    "build:geometry-editor": "vue-tsc --noEmit && LIB_MINIFY=0 vite build --config vite.geometry-editor.config.ts && LIB_MINIFY=1 vite build --config vite.geometry-editor.config.ts",
    "build:sketch": "vue-tsc --noEmit && LIB_MINIFY=0 vite build --config vite.sketch.config.ts && LIB_MINIFY=1 vite build --config vite.sketch.config.ts",
    "preview": "vite preview",
    "preview:pages": "GITHUB_REPOSITORY=ignf/gpu-entree-carto vite preview",
    "serve:pages": "npm run build:demo:pages && npm run preview:pages",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "verify": "npm run lint && npm run format:check && npm run typecheck",
    "codeql:install": "bash scripts/codeql-install.sh",
    "verify:codeql": "bash scripts/codeql-verify.sh",
    "fix": "npm run lint:fix && npm run format",
    "prepare": "husky"
  },
  "dependencies": {
    "@gouvfr/dsfr": "^1.15.3",
    "@gouvminint/vue-dsfr": "8.20.0",
    "@iconify/vue": "^5.0.0",
    "dompurify": "^3.4.15",
    "fast-xml-parser": "5.8.0",
    "geopf-extensions-openlayers": "^1.0.0-beta.14",
    "notivue": "^2.4.5",
    "ol": "^10.9.0",
    "remixicon": "^4.9.1",
    "vue": "^3.5.27",
    "vue-router": "5.0.3"
  },
  "overrides": {
    "maplibre-gl": "^6.10.0",
    "vue-router": "5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
