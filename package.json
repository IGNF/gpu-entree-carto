{
  "name": "entree-carto",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "type": "module",
  "description": "Entrée cartographique GPU (Vue 3, VueDSFR, OpenLayers)",
  "license": "CECILL-B",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IGNF/gpu-entree-carto.git"
  },
  "homepage": "https://ignf.github.io/gpu-entree-carto/",
  "bugs": "https://github.com/IGNF/gpu-entree-carto/issues",
  "main": "./dist/entree-carto.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node scripts/sync-demo-external.mjs && vite",
    "build": "vue-tsc --noEmit && node scripts/sync-demo-external.mjs && vite build && node scripts/build-bundles.mjs",
    "build:demo:pages": "node scripts/sync-demo-external.mjs && ENTREE_CARTO_DEMO_PAGES=1 GITHUB_REPOSITORY=ignf/gpu-entree-carto vite build",
    "serve:pages": "npm run build:demo:pages && GITHUB_REPOSITORY=ignf/gpu-entree-carto vite preview",
    "test": "vitest run",
    "verify": "eslint . --max-warnings 0 && prettier --check . && vue-tsc --noEmit",
    "verify:dist": "node scripts/check-dist.mjs dist",
    "verify:codeql": "bash scripts/codeql-verify.sh",
    "codeql:install": "bash scripts/codeql-install.sh",
    "fix": "eslint . --fix && prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@gouvfr/dsfr": "^1.15.4",
    "@gouvminint/vue-dsfr": "9.0.0",
    "@iconify/vue": "5.0.5",
    "@vueuse/core": "^15.0.0",
    "dompurify": "^3.5.0",
    "fast-xml-parser": "5.12.1",
    "geopf-extensions-openlayers": "^1.0.0-beta.16",
    "html2canvas": "^1.4.1",
    "notivue": "^2.4.5",
    "ol": "^10.11.0",
    "pdf-lib": "^1.17.1",
    "remixicon": "^4.9.1",
    "vue": "^3.5.46",
    "vue-router": "5.0.7"
  },
  "overrides": {
    "maplibre-gl": "^6.10.0",
    "vue-router": "5.0.7",
    "@gouvminint/vue-dsfr": {
      "vue-router": "$vue-router"
    },
    "minimatch": "^11.0.4",
    "glob": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "@gouvfr/dsfr@1.15.4": true,
    "esbuild@0.25.12": true
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,yml,css}": "prettier --write"
  }
}
